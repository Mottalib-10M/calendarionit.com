---
/** Guides et pages outils (es) : une fiche de src/content/pages.ts + un texte src/content/es/<id>.ts. */
import ContentPage from '../../components/ContentPage.astro';
import { PAGES } from '../../lib/guides';
import type { PageDef } from '../../lib/guide-types';
export function getStaticPaths() { return PAGES.map((page) => ({ params: { slug: page.es.slug }, props: { page } })); }
const { page } = Astro.props as { page: PageDef };
---
<ContentPage page={page} lang="es" />
